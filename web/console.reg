REGEDIT4

; Only the browser demo's newly created console uses this profile.
[HKEY_CURRENT_USER\Console\Kryz Browser]
"FaceName"="Lucida Console"
"FontFamily"=dword:00000036
"FontWeight"=dword:00000190
"FontSize"=dword:00140000
"ScreenBufferSize"=dword:012c007d
"WindowSize"=dword:001e007d

; Keep the disposable game VM free of Automatic Updates interruptions.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU]
"NoAutoUpdate"=dword:00000001
"NoAutoRebootWithLoggedOnUsers"=dword:00000001

; Suppress Automatic Updates notifications for the restored desktop user.
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Policies\WindowsUpdate]
"DisableWindowsUpdateAccess"=dword:00000001

