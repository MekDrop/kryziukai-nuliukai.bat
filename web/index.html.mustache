<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<meta name="description" content="{{ metaDescription }}">
<link rel="canonical" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<link rel="alternate" hreflang="en" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<link rel="alternate" hreflang="lt" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/lt.html">
<link rel="alternate" hreflang="x-default" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ socialTitle }}">
<meta property="og:description" content="{{ socialDescription }}">
<meta property="og:url" content="{{{ pageUrl }}}">
<meta property="og:locale" content="{{ ogLocale }}">
<meta property="og:locale:alternate" content="{{ alternateLocale }}">
<meta property="og:image" content="{{{ previewImageUrl }}}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ imageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ socialTitle }}">
<meta name="twitter:description" content="{{ socialDescription }}">
<meta name="twitter:image" content="{{{ previewImageUrl }}}">
<meta name="twitter:image:alt" content="{{ imageAlt }}">
<link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
<link rel="stylesheet" href="styles.css">
</head>
<body>
<div id="compatibility" role="alert">
<h1>Kryziukai-Nuliukai.bat</h1>
<p>{{ compatibility.unsupported }}</p><p>{{ compatibility.download }}</p>
<p><a href="https://github.com/MekDrop/kryziukai-nuliukai.bat">{{ compatibility.link }}</a></p>
<nav class="languages" aria-label="{{ ui.languages }}"><a href="index.html" hreflang="en" lang="en">{{ ui.en }}</a><a href="lt.html" hreflang="lt" lang="lt">{{ ui.lt }}</a></nav>
</div>
<div id="app">
<aside>
<h1>Kryziukai-Nuliukai.bat</h1>
<p>{{ ui.description }}</p>
<nav class="languages" aria-label="{{ ui.languages }}" title="{{ ui.restart }}">
<a href="index.html" hreflang="en" lang="en" aria-label="{{ ui.en }}" title="{{ ui.en }}"{{#isEnglish}} aria-current="page"{{/isEnglish}}>
<svg viewBox="0 0 60 30" preserveAspectRatio="none" aria-hidden="true"><path fill="#012169" d="M0 0h60v30H0z"/><path stroke="#fff" stroke-width="6" d="m0 0 60 30M60 0 0 30"/><path stroke="#c8102e" stroke-width="2" d="m0 0 60 30M60 0 0 30"/><path stroke="#fff" stroke-width="10" d="M30 0v30M0 15h60"/><path stroke="#c8102e" stroke-width="6" d="M30 0v30M0 15h60"/></svg>
</a>
<a href="lt.html" hreflang="lt" lang="lt" aria-label="{{ ui.lt }}" title="{{ ui.lt }}"{{#isLithuanian}} aria-current="page"{{/isLithuanian}}>
<svg viewBox="0 0 30 20" aria-hidden="true"><path fill="#fdb913" d="M0 0h30v7H0z"/><path fill="#006a44" d="M0 7h30v6H0z"/><path fill="#c1272d" d="M0 13h30v7H0z"/></svg>
</a>
</nav>
<a class="download" href="{{ latestReleaseZipUrl }}">{{ ui.download }}</a>
<p id="status" role="status" aria-live="polite">{{ ui.checking }}</p>
<p class="hint" id="machine-input-hint"><span>{{ ui.keyboard }}</span><br><span id="mouse-hint">{{ ui.mouseAvailable }}</span><br><span>{{ ui.reload }}</span></p>
<footer><a href="https://github.com/MekDrop/kryziukai-nuliukai.bat">{{ ui.source }}</a><a href="vendor/LICENSE">{{ ui.v86License }}</a><a href="vendor/BIOS-LICENSE.txt">{{ ui.biosLicense }}</a><a href="vendor/ANSICON-LICENSE.txt">{{ ui.ansiLicense }}</a></footer>
</aside>
<main aria-label="{{ ui.machine }}">
<div id="screen_container" role="application" aria-label="{{ ui.machine }}" aria-describedby="machine-input-hint" aria-keyshortcuts="Alt+M" tabindex="0"><div></div><canvas width="1024" height="768"></canvas></div>
</main>
</div>
<script>
(function () {
    // Preserve old shared language links while keeping each page's language fixed.
    var previousLanguage = /(?:^|[?&])lang=(en|lt)(?:&|$)/.exec(window.location.search);
    if (previousLanguage && previousLanguage[1] !== document.documentElement.lang) {
        window.location.replace(previousLanguage[1] === 'lt' ? 'lt.html' : 'index.html');
        return;
    }
    window.kryzBrowserSupported = false;
    try {
        var canvas = document.createElement('canvas');
        var supported = 'noModule' in document.createElement('script') &&
            typeof WebAssembly === 'object' && typeof WebAssembly.instantiate === 'function' &&
            typeof Promise === 'function' && typeof fetch === 'function' &&
            typeof URL === 'function' &&
            typeof BigInt === 'function' && typeof ResizeObserver === 'function' &&
            typeof MutationObserver === 'function' && window.CSS &&
            CSS.supports('display', 'grid') && canvas.getContext && canvas.getContext('2d');
        if (!supported) return;
        // Parse modern syntax without exposing it to legacy script parsers.
        new Function('const x = {}; return async () => { await import("data:text/javascript,"); return x?.value ?? 0; };');
        window.kryzBrowserSupported = true;
        function showCompatibility() {
            document.getElementById('app').style.display = 'none';
            document.getElementById('compatibility').style.display = 'block';
        }
        window.addEventListener('error', showCompatibility);
        window.addEventListener('unhandledrejection', showCompatibility);
    } catch (error) {
        // The static fallback stays readable even if a feature probe fails.
    }
}());
</script>
<script type="module">
if (window.kryzBrowserSupported) {
    document.getElementById('app').style.display = 'grid';
    document.getElementById('compatibility').style.display = 'none';
const status = document.querySelector('#status');
const stage = document.querySelector('main');
const screen = document.querySelector('#screen_container');
const canvas = screen.querySelector('canvas');
const language = document.documentElement.lang;
const text = {{{ runtimeText }}};
function fitScreen() {
    const scale = Math.min(stage.clientWidth / canvas.width, stage.clientHeight / canvas.height);
    if (!Number.isFinite(scale) || scale <= 0) return;
    screen.style.width = `${Math.floor(canvas.width * scale)}px`;
    screen.style.height = `${Math.floor(canvas.height * scale)}px`;
}
new ResizeObserver(fitScreen).observe(stage);
new MutationObserver(fitScreen).observe(canvas, { attributes: true, attributeFilter: ['width', 'height'] });
fitScreen();
let emulator;
const mouseHint = document.querySelector('#mouse-hint');
async function captureMouse() {
    if (!emulator?.is_running() || document.pointerLockElement === screen) return;
    try {
        await screen.requestPointerLock();
    } catch {
        mouseHint.textContent = text.mouseUnavailable;
    }
}
screen.addEventListener('click', captureMouse);
document.addEventListener('pointerlockchange', () => {
    const captured = document.pointerLockElement === screen;
    mouseHint.textContent = captured
        ? text.mouseCaptured
        : text.mouseAvailable;
    if (captured) screen.focus({ preventScroll: true });
});
screen.addEventListener('keydown', event => {
    if (event.altKey && event.code === 'KeyM') {
        event.preventDefault();
        event.stopPropagation();
        void captureMouse();
    }
    if (event.key === 'Escape' && document.pointerLockElement === screen) document.exitPointerLock();
});
const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
async function runGame() {
    // Windows+R opens Run on the restored Windows 2000 desktop.
    emulator.keyboard_send_scancodes([0xe0, 0x5b, 0x13, 0x93, 0xe0, 0xdb]);
    await sleep(800);
    // Import guest font and update-notification policies before launching.
    // START's title selects HKCU\\Console\\Kryz Browser; the batch can then
    // change its visible title without changing the selected font.
    await emulator.keyboard_send_text(`cmd.exe /d /c start /wait regedit.exe /s A:\\console.reg & start "Kryz Browser" /max cmd.exe /d /c A:\\kryz.bat /ASCII /L ${language}\n`, 20);
    document.querySelector('#screen_container').focus({ preventScroll: true });
    status.textContent = text.launched;
}
function fail(error) {
    status.textContent = `${text.failed}: ${error.message || error}`;
}
try {
    status.textContent = text.loading;
    const { default: V86 } = await import('./vendor/libv86.mjs');
    // Match the hardware and prepared desktop of v86's Windows 2000 demo.
    emulator = new V86({
        wasm_path: 'vendor/v86.wasm',
        bios: { url: 'vendor/seabios.bin' },
        vga_bios: { url: 'vendor/vgabios.bin' },
        memory_size: 512 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        screen_container: screen,
        hda: {
            url: 'https://i.copy.sh/windows2k-v2/.img',
            size: 2147483648,
            async: true,
            use_parts: true,
            fixed_chunk_size: 262144,
        },
        initial_state: { url: 'https://i.copy.sh/windows2k_state-v4.bin.zst' },
        boot_order: 0x132,
        acpi: false,
        disable_speaker: true,
        autostart: false,
    });
    emulator.add_listener('download-error', () => fail(new Error(text.downloadFailed)));
    emulator.add_listener('emulator-ready', async () => {
        try {
            // Restore first, then insert the current game disk without caching it.
            const floppy = await fetch('game.img', { cache: 'no-store' });
            if (!floppy.ok) throw new Error(`game floppy HTTP ${floppy.status}`);
            await emulator.set_fda({ buffer: await floppy.arrayBuffer() });
            await emulator.run();
            await sleep(2000);
            await runGame();
        } catch (error) { fail(error); }
    });
} catch (error) { fail(error); }
}
</script>
</body>
</html>
