<!doctype html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ title }}</title>
<meta name="description" content="{{ metaDescription }}">
<link rel="canonical" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<link rel="alternate" hreflang="en" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<link rel="alternate" hreflang="lt" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/lt.html">
<link rel="alternate" hreflang="x-default" href="https://mekdrop.github.io/kryziukai-nuliukai.bat/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ socialTitle }}">
<meta property="og:description" content="{{ socialDescription }}">
<meta property="og:url" content="{{{ pageUrl }}}">
<meta property="og:locale" content="{{ ogLocale }}">
<meta property="og:locale:alternate" content="{{ alternateLocale }}">
<meta property="og:image" content="{{{ previewImageUrl }}}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ imageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ socialTitle }}">
<meta name="twitter:description" content="{{ socialDescription }}">
<meta name="twitter:image" content="{{{ previewImageUrl }}}">
<meta name="twitter:image:alt" content="{{ imageAlt }}">
<link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
<link rel="stylesheet" href="styles.css?v={{ stylesHash }}">
</head>
<body>
<div id="compatibility" role="alert">
<h1>Kryziukai-Nuliukai.bat</h1>
<p>{{ compatibility.unsupported }}</p><p>{{ compatibility.download }}</p>
<p><a href="https://github.com/MekDrop/kryziukai-nuliukai.bat">{{ compatibility.link }}</a></p>
<nav class="languages" aria-label="{{ ui.languages }}"><a href="index.html" hreflang="en" lang="en">{{ ui.en }}</a><a href="lt.html" hreflang="lt" lang="lt">{{ ui.lt }}</a></nav>
<div class="license-links"><a href="vendor/LICENSE" data-license>{{ ui.v86License }}</a> <a href="vendor/BIOS-LICENSE.txt" data-license>{{ ui.biosLicense }}</a> <a href="vendor/ANSICON-LICENSE.txt" data-license>{{ ui.ansiLicense }}</a></div>
</div>
<div id="app">
<aside>
<button class="mobile-menu-toggle" type="button" aria-label="{{ ui.menu }}" aria-expanded="false" aria-controls="mobile-menu">
<svg viewBox="0 0 20 16" aria-hidden="true"><path d="M1 2h18M1 8h18M1 14h18"/></svg>
</button>
<h1>Kryziukai-Nuliukai.bat</h1>
<p>{{ ui.description }}</p>
<nav class="languages" aria-label="{{ ui.languages }}" title="{{ ui.restart }}">
<a href="index.html" hreflang="en" lang="en" aria-label="{{ ui.en }}" title="{{ ui.en }}"{{#isEnglish}} aria-current="page"{{/isEnglish}}>
<svg viewBox="0 0 60 30" preserveAspectRatio="none" aria-hidden="true"><path fill="#012169" d="M0 0h60v30H0z"/><path stroke="#fff" stroke-width="6" d="m0 0 60 30M60 0 0 30"/><path stroke="#c8102e" stroke-width="2" d="m0 0 60 30M60 0 0 30"/><path stroke="#fff" stroke-width="10" d="M30 0v30M0 15h60"/><path stroke="#c8102e" stroke-width="6" d="M30 0v30M0 15h60"/></svg>
</a>
<a href="lt.html" hreflang="lt" lang="lt" aria-label="{{ ui.lt }}" title="{{ ui.lt }}"{{#isLithuanian}} aria-current="page"{{/isLithuanian}}>
<svg viewBox="0 0 30 20" aria-hidden="true"><path fill="#fdb913" d="M0 0h30v7H0z"/><path fill="#006a44" d="M0 7h30v6H0z"/><path fill="#c1272d" d="M0 13h30v7H0z"/></svg>
</a>
</nav>
<div class="secondary-actions" id="mobile-menu">
<a class="download" href="{{ latestReleaseZipUrl }}">{{ ui.download }}</a>
<footer><a href="https://github.com/MekDrop/kryziukai-nuliukai.bat">{{ ui.source }}</a><a href="vendor/LICENSE" data-license>{{ ui.v86License }}</a><a href="vendor/BIOS-LICENSE.txt" data-license>{{ ui.biosLicense }}</a><a href="vendor/ANSICON-LICENSE.txt" data-license>{{ ui.ansiLicense }}</a></footer>
</div>
<p id="status" role="status" aria-live="polite">{{ ui.checking }}</p>
<p class="hint" id="machine-input-hint"><span>{{ ui.keyboard }}<span class="mouse-shortcut"> {{ ui.mouseShortcut }}</span></span><br><span id="mouse-hint">{{ ui.mouseAvailable }}</span><br><span>{{ ui.reload }}</span></p>
</aside>
<main aria-label="{{ ui.machine }}">
<div id="screen_container" role="application" aria-label="{{ ui.machine }}" aria-describedby="machine-input-hint" aria-keyshortcuts="Alt+M" aria-disabled="true" tabindex="-1"><div></div><canvas width="1024" height="768"></canvas></div>
<button class="machine-cover" type="button" aria-hidden="true" disabled><span class="preparing-indicator"><span class="preparing-text">{{ ui.preparing }}</span><span class="preparing-progress"><span></span></span></span></button>
<textarea class="phone_keyboard" inputmode="text" enterkeyhint="enter" autocomplete="off" autocapitalize="none" spellcheck="false" aria-label="{{ ui.keyboard }}" tabindex="-1"></textarea>
</main>
</div>
<div id="license-modal" class="license-dialog" role="dialog" aria-modal="true" aria-labelledby="license-title" aria-hidden="true" data-loading="{{ ui.licenseLoading }}" data-failed="{{ ui.licenseFailed }}">
<div class="license-header"><h2 id="license-title"></h2><button type="button" class="license-close simplemodal-close">{{ ui.close }}</button></div>
<p id="license-status" role="status" aria-live="polite"></p>
<pre id="license-content" tabindex="0" aria-labelledby="license-title"></pre>
<a id="license-original" href="vendor/LICENSE" target="_blank" rel="noopener">{{ ui.openLicenseFile }}</a>
</div>
<script>
(function () {
    // Preserve old shared language links while keeping each page's language fixed.
    var previousLanguage = /(?:^|[?&])lang=(en|lt)(?:&|$)/.exec(window.location.search);
    if (previousLanguage && previousLanguage[1] !== document.documentElement.lang) {
        window.location.replace(previousLanguage[1] === 'lt' ? 'lt.html' : 'index.html');
        return;
    }
    window.kryzBrowserSupported = false;
    try {
        var canvas = document.createElement('canvas');
        var supported = 'noModule' in document.createElement('script') &&
            typeof WebAssembly === 'object' && typeof WebAssembly.instantiate === 'function' &&
            typeof Promise === 'function' && typeof fetch === 'function' &&
            typeof URL === 'function' &&
            typeof BigInt === 'function' && typeof ResizeObserver === 'function' &&
            typeof MutationObserver === 'function' && window.CSS &&
            CSS.supports('display', 'grid') && canvas.getContext && canvas.getContext('2d');
        if (!supported) return;
        // Parse modern syntax without exposing it to legacy script parsers.
        new Function('const x = {}; return async () => { await import("data:text/javascript,"); return x?.value ?? 0; };');
        window.kryzBrowserSupported = true;
        function showCompatibility() {
            document.getElementById('app').style.display = 'none';
            document.getElementById('compatibility').style.display = 'block';
        }
        window.addEventListener('error', showCompatibility);
        window.addEventListener('unhandledrejection', showCompatibility);
    } catch (error) {
        // The static fallback stays readable even if a feature probe fails.
    }
}());
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.12.4/jquery.min.js" integrity="sha384-nvAa0+6Qg9clwYCGGPpDQLVpLNn0fRaROjHqs13t4Ggj3Ez50XnGQqc/r8MhnRDZ" crossorigin="anonymous"></script>
<script>
if (!window.jQuery) document.write('<script src="vendor/jquery-1.12.4.min.js"><\/script>');
</script>
<script>
if (window.jQuery) document.write('<script src="https://cdn.jsdelivr.net/gh/ericmmartin/simplemodal@156e9d7e6967ac239f997e883a7882b36b4403b0/src/jquery.simplemodal.js" integrity="sha384-ajXYb/E6TygdbQQqxAcCFHU+sJNQxNtdqIrqp0ES26OGb8DboMv2/3iF4tHCy8Kk" crossorigin="anonymous"><\/script>');
</script>
<script>
if (window.jQuery && !window.jQuery.modal) document.write('<script src="vendor/jquery.simplemodal-1.4.5.js"><\/script>');
</script>
<script src="licenses.js"></script>
<script type="module">
if (window.kryzBrowserSupported) {
    const app = document.getElementById('app');
    const menuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileMenu = document.querySelector('#mobile-menu');
    app.classList.add('menu-enhanced');
    app.style.display = 'grid';
    document.getElementById('compatibility').style.display = 'none';
const status = document.querySelector('#status');
const stage = document.querySelector('main');
const screen = document.querySelector('#screen_container');
const machineCover = document.querySelector('.machine-cover');
const phoneKeyboard = document.querySelector('.phone_keyboard');
const canvas = screen.querySelector('canvas');
const language = document.documentElement.lang;
const text = {{{ runtimeText }}};
function closeMobileMenu({ restoreFocus = false } = {}) {
    mobileMenu.classList.remove('is-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    if (restoreFocus) menuToggle.focus();
}
menuToggle.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('is-open');
    menuToggle.setAttribute('aria-expanded', String(open));
});
mobileMenu.addEventListener('click', event => {
    if (event.target.closest('a')) closeMobileMenu();
});
document.addEventListener('pointerdown', event => {
    if (!mobileMenu.classList.contains('is-open')) return;
    if (!mobileMenu.contains(event.target) && !menuToggle.contains(event.target)) closeMobileMenu();
});
document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        event.preventDefault();
        closeMobileMenu({ restoreFocus: true });
    }
});
function setPixelSize(element, property, value) {
    const current = Number.parseFloat(element.style[property]);
    if (!Number.isFinite(current) || Math.abs(current - value) >= 1) {
        element.style[property] = `${value}px`;
    }
}
function fitScreen() {
    const canvasWidth = Number(canvas.width);
    const canvasHeight = Number(canvas.height);
    if (!Number.isFinite(canvasWidth) || !Number.isFinite(canvasHeight) || canvasWidth <= 0 || canvasHeight <= 0) return;
    let availableWidth;
    const mobileLayout = window.matchMedia('(max-width: 700px)').matches;
    if (mobileLayout) {
        const appStyle = getComputedStyle(app);
        const stageStyle = getComputedStyle(stage);
        const paddingX = Number.parseFloat(appStyle.paddingLeft) + Number.parseFloat(appStyle.paddingRight);
        const borderX = Number.parseFloat(stageStyle.borderLeftWidth) + Number.parseFloat(stageStyle.borderRightWidth);
        const borderY = Number.parseFloat(stageStyle.borderTopWidth) + Number.parseFloat(stageStyle.borderBottomWidth);
        availableWidth = Math.max(1, app.clientWidth - paddingX - borderX);
        // Mobile is width-first: status/help and the software keyboard may sit
        // below the viewport, but must never make the guest display narrower.
        const scale = availableWidth / canvasWidth;
        if (!Number.isFinite(scale) || scale <= 0) return;
        const width = Math.max(1, Math.floor(canvasWidth * scale));
        const height = Math.max(1, Math.floor(canvasHeight * scale));
        setPixelSize(screen, 'width', width);
        setPixelSize(screen, 'height', height);
        setPixelSize(stage, 'width', width + borderX);
        setPixelSize(stage, 'height', height + borderY);
        return;
    }
    if (stage.style.width) stage.style.width = '';
    if (stage.style.height) stage.style.height = '';
    availableWidth = stage.clientWidth;
    const availableHeight = stage.clientHeight;
    const scale = Math.min(availableWidth / canvasWidth, availableHeight / canvasHeight);
    if (!Number.isFinite(scale) || scale <= 0) return;
    setPixelSize(screen, 'width', Math.max(1, Math.floor(canvasWidth * scale)));
    setPixelSize(screen, 'height', Math.max(1, Math.floor(canvasHeight * scale)));
}
let fitFrame = 0;
function scheduleFitScreen() {
    if (fitFrame) return;
    fitFrame = requestAnimationFrame(() => {
        fitFrame = 0;
        fitScreen();
    });
}
const screenResizeObserver = new ResizeObserver(scheduleFitScreen);
screenResizeObserver.observe(app);
screenResizeObserver.observe(stage);
screenResizeObserver.observe(status);
screenResizeObserver.observe(document.querySelector('.hint'));
new MutationObserver(scheduleFitScreen).observe(canvas, { attributes: true, attributeFilter: ['width', 'height'] });
window.addEventListener('resize', scheduleFitScreen);
window.visualViewport?.addEventListener('resize', scheduleFitScreen);
fitScreen();
let emulator;
let licenseInputEnabled = true;
let launchInputActive = false;
function isUiSurface(element) {
    return element !== screen && element !== phoneKeyboard && !!element?.closest(
        '#license-modal, a[href], button, input, select, textarea, [contenteditable="true"]');
}
function uiControlHasFocus() {
    return isUiSurface(document.activeElement);
}
function syncEmulatorKeyboard() {
    const covered = !machineCover.classList.contains('is-hidden');
    emulator?.keyboard_set_enabled(launchInputActive || (!covered && licenseInputEnabled && !uiControlHasFocus()));
}
window.kryzSetLicenseInputEnabled = enabled => {
    licenseInputEnabled = enabled;
    syncEmulatorKeyboard();
    if (!enabled && document.pointerLockElement === screen) document.exitPointerLock();
};
document.addEventListener('focusin', syncEmulatorKeyboard);
document.addEventListener('focusout', () => setTimeout(syncEmulatorKeyboard, 0));
function isolateLaunchUiKey(event) {
    if (launchInputActive) event.stopImmediatePropagation();
}
// Registered before v86 installs its window listeners. Physical events have
// already reached their target and document here, so native page behavior
// works while no user keystroke can contaminate automatic command entry.
window.addEventListener('keydown', isolateLaunchUiKey);
window.addEventListener('keyup', isolateLaunchUiKey);
window.addEventListener('input', isolateLaunchUiKey);
document.addEventListener('keydown', event => {
    if (event.key !== 'Tab' || launchInputActive || document.activeElement === phoneKeyboard
        || document.activeElement === screen || document.pointerLockElement === screen) return;
    // v86 listens at window level. Yield Tab before its handler so browser
    // focus can move through page chrome without stealing guest Tab input.
    emulator?.keyboard_set_enabled(false);
    setTimeout(syncEmulatorKeyboard, 0);
}, true);
const mouseHint = document.querySelector('#mouse-hint');
function focusPhoneKeyboard() {
    const scrollPosition = { x: window.scrollX, y: window.scrollY };
    const restoreFocusScroll = () => {
        if (document.activeElement !== phoneKeyboard) return;
        if (window.scrollX !== scrollPosition.x || window.scrollY !== scrollPosition.y) {
            window.scrollTo(scrollPosition.x, scrollPosition.y);
        }
    };
    try { phoneKeyboard.focus({ preventScroll: true }); }
    catch { phoneKeyboard.focus(); }
    requestAnimationFrame(restoreFocusScroll);
    const viewport = window.visualViewport;
    viewport?.addEventListener('resize', restoreFocusScroll, { once: true });
    setTimeout(() => viewport?.removeEventListener('resize', restoreFocusScroll), 600);
}
async function captureMouse(event) {
    if (!machineCover.classList.contains('is-hidden') || !emulator?.is_running() || document.pointerLockElement === screen) return;
    const touchInteraction = event?.pointerType === 'touch'
        || (!event?.pointerType && window.matchMedia('(hover: none) and (pointer: coarse)').matches);
    if (touchInteraction) {
        focusPhoneKeyboard();
        return;
    }
    try {
        await screen.requestPointerLock();
    } catch {
        mouseHint.textContent = text.mouseUnavailable;
    }
}
screen.addEventListener('click', captureMouse);
document.addEventListener('pointerlockchange', () => {
    const captured = document.pointerLockElement === screen;
    mouseHint.textContent = captured
        ? text.mouseCaptured
        : text.mouseAvailable;
    if (captured) screen.focus({ preventScroll: true });
});
screen.addEventListener('keydown', event => {
    if (event.altKey && event.code === 'KeyM') {
        event.preventDefault();
        event.stopPropagation();
        void captureMouse();
    }
    if (event.key === 'Escape' && document.pointerLockElement === screen) document.exitPointerLock();
});
const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
async function runGame() {
    launchInputActive = true;
    syncEmulatorKeyboard();
    try {
        // Windows+R opens Run on the restored Windows 2000 desktop.
        emulator.keyboard_send_scancodes([0xe0, 0x5b, 0x13, 0x93, 0xe0, 0xdb]);
        await sleep(800);
        // Import guest font and update-notification policies before launching.
        // START's title selects HKCU\\Console\\Kryz Browser; the batch can then
        // change its visible title without changing the selected font.
        // Keep the device-installation restart prompt out of the game session.
        await emulator.keyboard_send_text(`cmd.exe /d /c start /wait regedit.exe /s A:\\console.reg & start "" A:\\guard.exe & start "Kryz Browser" /max cmd.exe /d /c A:\\kryz.bat /ASCII /L ${language}\n`, 20);
    } finally {
        launchInputActive = false;
        syncEmulatorKeyboard();
    }
    await sleep(1500);
    const touchLayout = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    if (touchLayout) {
        machineCover.querySelector('.preparing-text').textContent = text.tapToPlay;
        machineCover.classList.add('is-ready');
        machineCover.disabled = false;
        machineCover.setAttribute('aria-hidden', 'false');
        status.textContent = text.launched;
        return;
    }
    const active = document.activeElement;
    const shouldFocusScreen = !window.kryzLicenseOpen && !mobileMenu.classList.contains('is-open')
        && (!active || active === document.body || active === document.documentElement || active === screen);
    enableMachineInteraction();
    if (shouldFocusScreen) screen.focus({ preventScroll: true });
    status.textContent = text.launched;
}
machineCover.addEventListener('click', () => {
    if (!machineCover.classList.contains('is-ready')) return;
    // Keep focus synchronous with this trusted activation so mobile browsers
    // are allowed to open their software keyboard.
    focusPhoneKeyboard();
    enableMachineInteraction();
    status.textContent = text.launched;
});
function enableMachineInteraction() {
    machineCover.classList.add('is-hidden');
    machineCover.classList.remove('is-ready');
    machineCover.disabled = true;
    machineCover.setAttribute('aria-hidden', 'true');
    screen.tabIndex = 0;
    screen.removeAttribute('aria-disabled');
    syncEmulatorKeyboard();
}
function fail(error) {
    launchInputActive = false;
    enableMachineInteraction();
    status.textContent = `${text.failed}: ${error.message || error}`;
}
try {
    status.textContent = text.loading;
    const { default: V86 } = await import('./vendor/libv86.mjs');
    // Match the hardware and prepared desktop of v86's Windows 2000 demo.
    emulator = new V86({
        wasm_path: 'vendor/v86.wasm',
        bios: { url: 'vendor/seabios.bin' },
        vga_bios: { url: 'vendor/vgabios.bin' },
        memory_size: 512 * 1024 * 1024,
        vga_memory_size: 8 * 1024 * 1024,
        screen_container: screen,
        hda: {
            url: 'https://i.copy.sh/windows2k-v2/.img',
            size: 2147483648,
            async: true,
            use_parts: true,
            fixed_chunk_size: 262144,
        },
        initial_state: { url: 'https://i.copy.sh/windows2k_state-v4.bin.zst' },
        boot_order: 0x132,
        acpi: false,
        disable_speaker: true,
        autostart: false,
    });
    syncEmulatorKeyboard();
    emulator.add_listener('download-error', () => fail(new Error(text.downloadFailed)));
    emulator.add_listener('emulator-ready', async () => {
        try {
            // Restore first, then insert the current game disk without caching it.
            const floppy = await fetch('game.img', { cache: 'no-store' });
            if (!floppy.ok) throw new Error(`game floppy HTTP ${floppy.status}`);
            await emulator.set_fda({ buffer: await floppy.arrayBuffer() });
            await emulator.run();
            await sleep(2000);
            await runGame();
        } catch (error) { fail(error); }
    });
} catch (error) { fail(error); }
}
</script>
